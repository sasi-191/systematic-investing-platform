# copy this file to .env and change the values

# SQLite needs no setup. For PostgreSQL use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investing
DATABASE_URL=sqlite:///./investing.db

SECRET_KEY=put-a-long-random-text-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Fyers broker: create an app at myapi.fyers.in and use this redirect URL there
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/fyers/callback

# real orders are sent only when this is true
LIVE_TRADING_ENABLED=false

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# run the evening job by itself at 7-10 pm on weekdays
AUTO_DAILY_JOB=true
